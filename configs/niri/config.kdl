// Ajodi niri Configuration
// Ported from Ricelin (Hyprland)

environment {
    XCURSOR_THEME "Bibata-Modern-Ice"
    XCURSOR_SIZE "24"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORMTHEME "kde"
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

input {
    keyboard {
        xkb {
            layout "gb"
        }
        repeat-delay 400
        repeat-rate 40
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.0
        accel-profile "flat"
    }
    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }
    focus-follows-mouse
}

layout {
    gaps 12
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#e0563b"
        inactive-color "#313a4d"
    }

    border {
        off
    }

    shadow {
        on
        softness 12
        spread 2
        offset x=0 y=4
        color "#14110faa"
    }
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 200
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
}

// Named workspaces (emulates special workspaces and user spaces)
workspace "stash"
workspace "private"
workspace "minimized"
workspace "discord"

// Autostart processes
spawn-sh-at-startup "~/.config/niri/scripts/cliphist-watch.sh"
spawn-sh-at-startup "~/.config/niri/scripts/wallpaper.sh init"
spawn-at-startup "systemctl" "--user" "start" "niri-session.target"
spawn-at-startup "polkit-gnome-authentication-agent-1"
spawn-sh-at-startup "~/.config/niri/scripts/watchdog.sh pill"
spawn-sh-at-startup "~/.config/niri/scripts/watchdog.sh lock"
spawn-at-startup "systemctl" "--user" "restart" "swayidle"
spawn-at-startup "fastfetch"

// Modular includes
include "outputs.kdl"
include "binds.kdl"
include "rules.kdl"
include "colors.kdl"
include "gamemode.kdl"


